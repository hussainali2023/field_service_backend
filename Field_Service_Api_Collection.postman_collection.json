              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"David Miller\",\n  \"email\": \"david.tech@fieldservice.com\",\n  \"password\": \"Tech@12345\",\n  \"phone\": \"+1-555-0205\",\n  \"skills\": [\"Electrical\", \"Smart Home\"],\n  \"experienceYears\": 6,\n  \"hourlyRate\": 60.0,\n  \"serviceArea\": \"Metro West\",\n  \"bio\": \"Specialist in residential solar & high-efficiency circuit installation.\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/technicians", "host": ["{{baseUrl}}"], "path": ["api", "v1", "technicians"] }
          }
        },
        {
          "name": "List Technicians (Public with Filters)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/technicians?skill=HVAC&isAvailable=true",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "technicians"],
              "query": [
                { "key": "skill", "value": "HVAC" },
                { "key": "isAvailable", "value": "true" }
              ]
            }
          }
        },
        {
          "name": "Get Technician By ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/technicians/:id", "host": ["{{baseUrl}}"], "path": ["api", "v1", "technicians", ":id"] }
          }
        },
        {
          "name": "Check Technician Availability & Schedule Conflicts",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/technicians/:id/availability?startDate=2026-10-03T05:00:00.000Z&endDate=2026-10-03T07:00:00.000Z",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "technicians", ":id", "availability"],
              "query": [
                { "key": "startDate", "value": "2026-10-03T05:00:00.000Z" },
                { "key": "endDate", "value": "2026-10-03T07:00:00.000Z" }
              ]
            }
          }
