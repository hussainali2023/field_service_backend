              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estimatedPrice\": 180.0,\n  \"adminNotes\": \"Checked electrical load; assigned for breaker and panel diagnostics.\",\n  \"urgency\": \"HIGH\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/service-requests/:id/review", "host": ["{{baseUrl}}"], "path": ["api", "v1", "service-requests", ":id", "review"] }
          }
        },
