          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{techToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"IN_PROGRESS\",\n  \"notes\": \"Arrived at customer premises and initiated panel load test.\"\n}"
