          "name": "Assign Technician with Conflict Detection (Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"technicianId\": \"{{technicianId}}\",\n  \"scheduledDate\": \"2026-10-06T14:00:00.000Z\",\n  \"scheduledEndDate\": \"2026-10-06T17:00:00.000Z\",\n  \"notes\": \"Assigned to master technician with specialized load gear.\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/service-requests/:id/assign", "host": ["{{baseUrl}}"], "path": ["api", "v1", "service-requests", ":id", "assign"] }
          }
        },
