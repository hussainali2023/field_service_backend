    {
      "name": "8. Reviews & Feedback",
      "item": [
        {
          "name": "Submit Customer Review",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"serviceRequestId\": \"{{requestId}}\",\n  \"rating\": 5,\n  \"comment\": \"Outstanding service! Technician arrived promptly, resolved the fault safely, and explained everything clearly.\"\n}"
            },
