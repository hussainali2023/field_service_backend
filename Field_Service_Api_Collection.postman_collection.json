            "body": {
              "mode": "raw",
              "raw": "{\n  \"serviceId\": \"{{serviceId}}\",\n  \"title\": \"Main Breaker Tripping Continuously\",\n  \"description\": \"The 50A breaker trips whenever the oven and dryer run concurrently. Smells faintly hot.\",\n  \"address\": \"420 Oak Avenue, Apt 2\",\n  \"urgency\": \"HIGH\",\n  \"preferredDate\": \"2026-10-06T14:00:00.000Z\"\n}"
