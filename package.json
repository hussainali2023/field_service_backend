{
  "name": "field_service_backend",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "deploy": "npm run build && vercel --prod",
